{
  "name": "spikey-coins-express-backend",
  "version": "1.0.0",
  "description": "Express backend for Spikey Coins trading platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "NODE_OPTIONS='--max-old-space-size=460' node dist/server.js",
    "start:debug": "NODE_OPTIONS='--inspect=9229' node dist/server.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "trading",
    "express",
    "api",
    "backend"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@binance/connector": "^3.6.1",
    "@google/generative-ai": "^0.24.1",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.19.43",
    "axios": "^1.18.1",
    "bottleneck": "^2.19.5",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.22.2",
    "express-session": "^1.19.0",
    "helmet": "^7.1.0",
    "mongoose": "^8.24.1",
    "morgan": "^1.11.0",
    "node-cron": "^4.5.0",
    "protobufjs": "^7.6.4",
    "typescript": "^5.5.4",
    "upstox-js-sdk": "^2.29.0",
    "web-push": "^3.6.7",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.56.0",
    "ts-node-dev": "^2.0.0",
    "vitest": "^4.1.9"
  },
  "optionalDependencies": {
    "bufferutil": "4.1.0",
    "utf-8-validate": "6.0.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
