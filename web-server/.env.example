PORT=8000
GOOGLE_CLIENT_ID=google_client_id
GOOGLE_CLIENT_SECRET=google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
MONGODB_URI=mongodb://localhost:27017/open-mandi-local
SESSION_SECRET=your_session_secret_here

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
BASE_URL=http://localhost:8000
ENCRYPTION_KEY=your_encryption_key_here
FRONTEND_URL=http://localhost:3000
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:you@example.com

GEMINI_API_KEY=your-key-here
AI_MODEL=gemini-2.5-flash  # optional

COINGECKO_API_KEY=your-coingecko-api-key-here

# ============================================
# Demo Binance Account (Optional)
# ============================================
# If set, enables a demo Binance testnet account for all users
# Non-authenticated users can view data but cannot trade
# Get API keys from: https://testnet.binancefuture.com/

DEMO_BINANCE_API_KEY=
DEMO_BINANCE_API_SECRET=
DEMO_BINANCE_TESTNET=true
DEMO_ACCOUNT_NAME=Binance Demo (Testnet)