# API Configuration
#
# Local dev (recommended): leave VITE_API_URL unset.
# The frontend will call relative /api paths and Vite will proxy them to the backend
# (see vite.config.ts). This is especially important when you're using Remote SSH / port
# forwarding: the browser's "localhost" is your laptop, not the remote machine.
#
# Production / deployed frontend: set VITE_API_URL to the origin where the API is hosted.
# Example:
# VITE_API_URL=https://api.your-domain.com

